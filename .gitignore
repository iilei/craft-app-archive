# Release signing key fetched by `mise run keys:fetch`
/keys/

# Default archive output of `mise run archive`, its staging directory (kept after
# a failed run for --resume), its lock, and backups left only if a run is killed
/craft-archive/
/.craft-archive.stage/
/.craft-archive.lock/
/.craft-archive.backup.*/

# Default wiki archive of `mise run wiki:archive`
/craft-wiki/
